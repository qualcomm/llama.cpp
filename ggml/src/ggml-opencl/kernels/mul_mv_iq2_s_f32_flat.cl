// Four grid values with their signs applied, as floats.
inline float4 iq2s_vals(uint gv, uint sg, uint base) {
    const uint s = sg >> base;
    float4 v;
    v.s0 = (float)((gv      ) & 0xFFu); if (s & 1u) { v.s0 = -v.s0; }
